              "type": "boolean",
              "default": false
            },
            "edit": {
              "type": "boolean",
              "default": false
            },
            "delete": {
              "type": "boolean",
              "default": false
            },
            "export": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "billings": {
          "type": "object",
          "properties": {
            "view": {
              "type": "boolean",
              "default": true
            },
            "create": {
              "type": "boolean",
              "default": false
            },
            "edit": {
              "type": "boolean",
              "default": false
            },
            "delete": {
              "type": "boolean",
              "default": false
            },
            "export": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "additives": {
          "type": "object",
          "properties": {
            "view": {
              "type": "boolean",
              "default": true
            },
            "create": {
              "type": "boolean",
              "default": false
            },
            "edit": {
              "type": "boolean",
              "default": false
            },
            "delete": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "sienge": {
          "type": "object",
          "properties": {
