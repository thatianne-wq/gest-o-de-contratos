{
  "name": "Billing",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "ID do contrato relacionado"
    },
    "additive_id": {
      "type": "string",
      "description": "ID do aditivo relacionado (opcional, se medindo um aditivo)"
    },
    "type": {
      "type": "string",
      "enum": [
        "medicao",
        "fd"
      ],
      "default": "medicao",
      "description": "Tipo de faturamento: Medi\u00e7\u00e3o ou FD"
    },
    "is_sinal": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o faturamento \u00e9 um sinal"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do faturamento"
    },
    "value": {
      "type": "number",
      "description": "Valor faturado"
    },
    "month": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia (YYYY-MM)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do faturamento"
    }
  },
  "required": [
    "contract_id",
    "value",
    "month"
  ]
}